# Mailtrap API token (required)
# Get yours at https://mailtrap.io/api-tokens
MAILTRAP_API_TOKEN=your_api_token_here

# Default account ID (optional — auto-discovered if not set)
# MAILTRAP_ACCOUNT_ID=12345

# Default sender email for sending tools (optional — avoids specifying per call)
# MAILTRAP_DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Default sandbox inbox ID for send_test_email (optional)
# MAILTRAP_TEST_INBOX_ID=12345

# Enable debug logging (optional)
# DEBUG=true
