{
  "name": "mcpj-mailtrap",
  "version": "0.2.0",
  "description": "MCP server for the Mailtrap email platform — analytics, sending, contacts, sandbox",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcpj-mailtrap": "dist/index.js"
  },
  "files": [
    "dist",
    "logo.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=mcpj-mailtrap",
    "build:npm": "bun build src/index.ts --target=node --outfile=dist/index.js && node -e \"const f=require('fs');const c=f.readFileSync('dist/index.js','utf8');f.writeFileSync('dist/index.js','#!/usr/bin/env node\\n'+c)\" && chmod +x dist/index.js",
    "prepublishOnly": "bun run build:npm",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "biome check --write .",
    "inspect": "bunx @modelcontextprotocol/inspector bun src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "esbuild": "^0.28.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/bun": "^1.3.12",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "mcp",
    "mailtrap",
    "email",
    "analytics",
    "model-context-protocol",
    "claude",
    "ai"
  ],
  "author": "pijusz",
  "homepage": "https://github.com/pijusz/mcp-mailtrap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pijusz/mcp-mailtrap.git"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "mcpName": "io.github.pijusz/mcp-mailtrap"
}
